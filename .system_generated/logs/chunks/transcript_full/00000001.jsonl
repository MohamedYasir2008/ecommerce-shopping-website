\">View All Orders</a>\n        `;\n        recentContainer.appendChild(div);\n    });\n})();","Path":"C:\\Users\\MY-PC\\.gemini\\antigravity\\brain\\68b1e791-e5ed-4ad6-9fc6-05d27d9c0cc7\\customer\\dashboard.js"}}]}
