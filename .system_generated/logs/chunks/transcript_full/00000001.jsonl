ge, remove, show subtotal.\n\nImplement checkout.html with form fields.\n\nImplement checkout.js: on submit create order object, validate stock, reduce product stock, clear cart, redirect to order-success.html (which we need to create).\n\nImplement order-success.html to show order ID.\n\nImplement order list for customer: orders.html shows list of orders for logged-in user.\n\nImplement order details page: order-details.html shows order info.\n\nSimplify: use URL parameter ?id=orderId.\n\nImplement seller add-product.html with a form; on submit create product with status pending.\n\nImplement manage-products.html: list of seller's products with edit/delete.\n\nImplement edit-product.html: prepopulate form.\n\nImplement seller manage-orders.html: list orders where order.sellerId matches seller.\n\nImplement admin product-approval.html: list pending products with approve/reject buttons.\n\nImplement approve/reject logic.\n\nImplement admin dashboard with small stats.\n\nImplement basic category management (add/simple categories) maybe not needed for demonstration.\n\nBecause of length constraints, we must be concise.\n\nWe'll generate the files now.\n\n","tool_calls":[{"name":"write_file","args":{"Content":"// cart.js – display items, edit quantities, remove, compute totals\n(function(){\n    const storage = window.StorageAPI;\n    const sess = storage.getSession();\n    if(!sess || sess.role!=='customer'){\n        alert('Login as a customer to view cart');\n        window.location.href='../login.html';\n        return;\n    }\n    const cartContainer = document.getElementById('cart-items');\n    const totalEl = document.getElementById('cart-total');\n\n    function render(){\n        const cart = storage.getCart(sess.userId);\n        if(cart.length===0){\n            cartContainer.innerHTML = '<p>Your cart is empty.</p>';\n            totalEl.textContent = '';\n            return;\n        }\n        const products = storage.get(storage.keys.products) || [];\n        let total = 0;\n        const table = document.createElement('table');\n        table.innerHTML = `<tr><th>Product</th><th>Qty</th><th>Price</th><th>Sub</th><th>Actions</th></tr>`;\n        cart.forEach(item=>{\n            const prod = products.find(p=>p.id===item.productId);\n            if(!prod) return; // skip deleted\n            const sub = prod.price * item.quantity;\n            total += sub;\n            const row = document.createElement('tr');\n            row.innerHTML = `\n                <td>${prod.name}</td>\n                <td><input type='number' min='1' max='${prod.stock}' value='${item.quantity}' data-id='${item.productId}' class='qty-input' /></td>\n                <td>₹${prod.price.toFixed(2)}</td>\n                <td>₹${sub.toFixed(2)}</td>\n                <td><button class='btn' data-id='${item.productId}'>Remove</button></td>\n            `;\n            table.appendChild(row);\n        });\n        cartContainer.innerHTML = '';\n        cartContainer.appendChild(table);\n        totalEl.textContent = 'Total: ₹' + total.toFixed(2);\n        // listeners\n        cartContainer.querySelectorAll('.qty-input').forEach(inp=>{\n            inp.addEventListener('change', function(){\n                const pid = this.dataset.id;\n                const newQty = parseInt(this.value);\n                const prod = products.find(p=>p.id===pid);\n                if(newQty>prod.stock){\n                    alert('Cannot exceed stock');\n                    this.value = prod.stock;\n                    return;\n                }\n                const cart = storage.getCart(sess.userId);\n                const entry = cart.find(i=>i.productId===pid);\n                if(entry){ entry.quantity = newQty; }\n                storage.setCart(sess.userId, cart);\n                render();\n            });\n        });\n        cartContainer.querySelectorAll('button').forEach(btn=>{\n            btn.addEventListener('click', function(){\n                const pid = this.dataset.id;\n                let cart = storage.getCart(sess.userId);\n                cart = cart.filter(i=>i.productId!==pid);\n                storage.setCart(sess.userId, cart);\n                render();\n            });\n        });\n    }\n    document.addEventListener('DOMContentLoaded', render);\n})();","Overwrite":true,"Path":"C:\\Users\\MY-PC\\.gemini\\antigravity\\brain\\68b1e791-e5ed-4ad6-9fc6-05d27d9c0cc7\\assets\\js\\cart.js"}}]}
