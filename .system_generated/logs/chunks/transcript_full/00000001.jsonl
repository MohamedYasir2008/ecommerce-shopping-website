link rel=\"stylesheet\" href=\"../assets/css/style.css\" />\n</head>\n<body>\n    <header>\n        <nav id=\"navbar\"></nav>\n    </header>\n    <main class=\"container\" id=\"dashboard\">\n        <h1>Welcome, <span id=\"custName\"></span>!</h1>\n        <div class=\"grid\">\n            <div class=\"card\">\n                <h3>Total Orders</h3>\n                <p id=\"totalOrders\">0</p>\n            </div>\n            <div class=\"card\">\n                <h3>Pending Orders</h3>\n                <p id=\"pendingOrders\">0</p>\n            </div>\n        </div>\n        <h2>Recent Orders</h2>\n        <div id=\"recentOrders\"></div>\n        <h2>Quick Links</h2>\n        <ul>\n            <li><a href=\"../products.html\">Products</a></li>\n            <li><a href=\"cart.html\">My Cart</a></li>\n            <li><a href=\"orders.html\">My Orders</a></li>\n            <li><a href=\"profile.html\">My Profile</a></li>\n        </ul>\n    </main>\n    <footer class=\"footer\"><p>&copy; 2026 Simple E‑Commerce</p></footer>\n    <script src=\"../assets/js/storage.js\"></script>\n    <script src=\"../assets/js/auth.js\"></script>\n    <script src=\"../assets/js/main.js\"></script>\n    <script src=\"dashboard.js\"></script>\n</body>\n</html>","Overwrite":true,"Path":"C:\\Users\\MY-PC\\.gemini\\antigravity\\brain\\68b1e791-e5ed-4ad6-9fc6-05d27d9c0cc7\\customer\\dashboard.html"}}]}
