});\\n\\n    function getCategoryName(catId){\\n        const cat = (storage.get(storage.keys.categories)||[]).find(c=>c.id===catId);\\n        return cat ? cat.name : '';\\n    }\\n})();\"","Path":"\"C:\\\\Users\\\\MY-PC\\\\.gemini\\\\antigravity\\\\brain\\\\68b1e791-e5ed-4ad6-9fc6-05d27d9c0cc7\\\\assets\\\\js\\\\product-details.js\""}}]}
