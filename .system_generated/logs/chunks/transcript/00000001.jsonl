ryStatus: 'Placed',\n deliveryAddress: { name: fullName, address, phone },\n orderDate: new Date().toISOString()\n}\n\nAlso include sellerId per item if needed but not essential for now.\n\nSave order: get orders array, push, set.\n\nUpdate product stock: for each item, find product, subtract quantity, if stock becomes 0 set status 'out_of_stock'.\n\nUpdate storage.\n\nClear cart.\n\nShow confirmation with orderId.\n\nNow orders.js: fetch orders, filter by customerId, render cards.\n\nProfile.js: get session, display name, email, phone, address (need to store phone and address in user profile). In storage, user object currently has name, email, password, role. We'll add fields: phone, address. When user updates, modify user in users array and also update session name.\n\nImplement.\n\nNow code files.\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"// checkout.js – renders cart summary and processes order placement\\n(function(){\\n    const storage = window.StorageAPI;\\n    const sess = storage.getSession();\\n    if(!sess || sess.role!=='customer'){\\n        alert('Please log in as a customer');\\n        window.location.href='../login.html';\\n        return;\\n    }\\n    const summaryDiv = document.getElementById('orderSummary');\\n    const form = document.getElementById('checkoutForm');\\n    const confirmDiv = document.getElementById('confirmationMessage');\\n    const orderIdDisplay = document.getElementById('orderIdDisplay');\\n\\n    function renderSummary(){\\n        const cart = storage.getCart(sess.userId);\\n        if(cart.length===0){\\n            summaryDiv.innerHTML = '<p>Your cart is empty.</p>';\\n            form.style.display='none';\\n            return;\\n        }\\n        const products = storage.get(storage.keys.products) || [];\\n        let total = 0;\\n        const table = document.createElement('table');\\n        table.innerHTML = `<tr><th>Product</th><th>Qty</th><th>Price</th><th>Sub‑total</th></tr>`;\\n        car