eller?), quantity, status.\n- Provide a dropdown to change status (Placed > Packed > Shipped > Delivered). Only allow forward progression maybe.\n\nSimplify: For each order, show current deliveryStatus, a select with options, and a button to save.\n\nImplement update: modify order.deliveryStatus, store back, and show toast.\n\nCreate `manage-orders.js`.\n\nAlso add `reports.js`:\n\n- Compute total revenue: sum of order items where sellerId matches and order status not cancelled? For simplicity sum all subTotal values for items belonging to seller.\n\n- Count total orders.\n\n- Show figure.\n\nNow we need to create these JS files.\n\nAlso fix navigation: seller pages include `../assets/js/main.js` which builds navbar; that script already loads `buildNav` and role detection.\n\nNow we need to edit `seller/manage-orders.html` includes script `manage-orders.js`.\n\nImplement.\n\nNow create files.\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"// manage-orders.js – seller view of orders containing their products & status updates\\n(function(){\\n    const storage = window.StorageAPI;\\n    const sess = storage.getSession();\\n    if(!sess || sess.role!=='seller'){\\n        alert('Please log in as a seller');\\n        window.location.href='../login.html';\\n        return;\\n    }\\n    const orders = storage.get(storage.keys.orders) || [];\\n    const users = storage.get(storage.keys.users) || [];\\n    const sellerOrders = orders.filter(o=>o.items.some(it=>it.sellerId===sess.userId));\\n    const container = document.getElementById('ordersList');\\n\\n    if(sellerOrders.length===0){\\n        container.innerHTML = '<p>No orders for your products yet.</p>';\\n        return;\\n    }\\n\\n    sellerOrders.forEach(order=>{\\n        const card = document.createElement('div');\\n        card.className='card';\\n        // find customer name\\n        const cust = users.find(u=>u.id===order.customerId);\\n        const custName = cust ? cust.name || cust.email : 'Unknown';\\n        // list only items that belong to this seller\\n        const myItems = order.items.filter(it=>it.sellerId===sess.userId);\\n        const itemsHtml = myItems.map(it=>`<li>${it.name} (x${it.quantity}) – ₹${it.price.toFixed(2)} each</li>`).join('');\\n        // status dropdown\\n        const statusOptions = ['Placed','Packed','Shipped','Delivered'];\\n        const selectHtml = statusOptions.map(st=>`<option value=\\\"${st}\\\" ${st===order.deliveryStatus?'selected':''}>${st}</option>`).join('');\\n        card.innerHTML = `\\n            <p><strong>Order ID:</strong> ${order.orderId}</p>\\n            <p><strong>Date:</strong> ${new Date(order.orderDate).toLocaleString()}</p>\\n            <p><strong>Customer:</strong> ${custName}</p>\\n            <p><strong>Items:</strong></p>\\n            <ul>${itemsHtml}</ul>\\n            <p><strong>Status:</strong> \\n                <select class=\\\"statusSelect\\\">${selectHtml}</select>\\n                <button class=\\\"btn saveBtn\\\">Save</button>\\n            </p>\\n \n<truncated 749 bytes>"}}],"truncated_fields":["tool_calls"]}
